# ── Supabase ── get from app.supabase.com → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ── Stripe ── get from dashboard.stripe.com → Developers → API keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# ── Claude API ── get from console.anthropic.com → API keys
# Powers the AI listing analyzer (image → title, description, price)
VITE_CLAUDE_API_KEY=sk-ant-YOUR_KEY_HERE

# ── PhotoRoom ── get from photoroom.com/api
# Powers background removal on listing photos
VITE_PHOTOROOM_API_KEY=YOUR_PHOTOROOM_KEY_HERE
